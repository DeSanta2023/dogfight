{
  "name": "dogfight",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "shared",
    "client",
    "server"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "npm run dev --workspace client",
    "dev:server": "npm run dev --workspace server",
    "build": "npm run build --workspace client",
    "start": "npm run start --workspace server",
    "test": "npm test --workspaces",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "determinism": "npm run determinism --workspace client",
    "this-bug": "npm run this-bug --workspace client",
    "prototypes": "npm run prototypes --workspace client",
    "puzzles": "npm run puzzles --workspace client",
    "load-timing": "npm run load-timing --workspace client",
    "blocking-demo": "npm run blocking-demo --workspace server",
    "error-crash": "npm run error-crash --workspace server",
    "rss-experiment": "npm run rss-experiment --workspace server",
    "event-loop-order": "npm run event-loop-order --workspace server",
    "tick-demo": "npm run tick-demo --workspace server",
    "wire-size": "npm run wire-size --workspace shared",
    "typecheck": "tsc -p shared && tsc -p shared/tsconfig.test.json && tsc -p server && tsc -p client && tsc -p e2e",
    "build:profile": "npm run build:profile --workspace client",
    "perf:client": "node perf/scripts/profile-client.mjs",
    "perf:load": "node perf/scripts/load.mjs",
    "test:e2e": "playwright test",
    "coverage": "npm run coverage --workspace shared"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.5",
    "@types/ws": "^8.18.2",
    "@vitest/coverage-v8": "^5.1.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "fast-check": "^4.10.3",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.1"
  }
}
